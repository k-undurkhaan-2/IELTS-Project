{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Current Authority Record v1",
  "description": "Prospective caller-authenticated authority outside the candidate checkout. Required evidence IDs remain independent prerequisites and cannot use the reserved LC- local-cache namespace; publication is not supported by this record.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "authority_id", "candidate_tree", "allowed_actions", "destination", "required_evidence", "recovery", "stop_conditions", "issued_at", "issued_by"],
  "$defs": {
    "text": {"type": "string", "minLength": 1, "pattern": "^(?=.*\\S)[^\\u0000-\\u001f]*$"},
    "oid": {"type": "string", "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"},
    "ref": {"type": "string", "pattern": "^refs/(?!.*(?:\\.\\.|@\\{|//|[\\u0000-\\u0020\\u007f~^:?*\\[\\\\]))(?!(?:[^/]+/)*\\.)(?!(?:[^/]+/)*[^/]*(?:\\.|\\.lock)(?:/|$))[^/]+(?:/[^/]+)+$"}
  },
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "authority_id": {"$ref": "#/$defs/text"},
    "candidate_tree": {"$ref": "#/$defs/oid"},
    "allowed_actions": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["stage", "sign", "verify"]}},
    "destination": {
      "type": "object", "additionalProperties": false, "required": ["role", "ref"],
      "properties": {"role": {"$ref": "#/$defs/text"}, "ref": {"$ref": "#/$defs/ref"}}
    },
    "required_evidence": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/text", "pattern": "^(?!LC-)"}},
    "recovery": {
      "type": "object", "additionalProperties": false, "required": ["allowed_classes", "max_retries"],
      "properties": {
        "allowed_classes": {"type": "array", "uniqueItems": true, "items": {"enum": ["parser", "environment"]}},
        "max_retries": {"type": "integer", "const": 1}
      }
    },
    "stop_conditions": {"type": "array", "minItems": 3, "maxItems": 3, "uniqueItems": true, "items": {"enum": ["candidate_changed", "destination_changed", "authority_changed"]}},
    "issued_at": {"type": "string", "format": "date-time"},
    "issued_by": {"$ref": "#/$defs/text"}
  }
}
